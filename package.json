{
  "name": "fh-clone",
  "private": true,
  "version": "3.0.0",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/aircraft-core",
    "packages/adapters/dji-cloud",
    "packages/adapters/dji-thermal",
    "packages/adapters/ugcs",
    "apps/control-api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:authz": "npm run build && node --test apps/control-api/dist/authz.test.js",
    "test:msdk-evidence": "node --test scripts/verify-msdk-evidence.test.mjs",
    "test:dji-mqtt-evidence": "node --test scripts/redact-dji-mqtt-evidence.test.mjs",
    "test:m3m-capture-evidence": "npm run build --workspace @fh-clone/adapter-dji-cloud && node --test scripts/export-m3m-capture-evidence.test.mjs",
    "test:msdk-media-lifecycle": "node --test scripts/verify-msdk-media-lifecycle.test.mjs",
    "test:msdk-control-deadman": "node --test scripts/verify-msdk-control-deadman.test.mjs",
    "test:github-support-handoff": "node --test scripts/github-sensitive-data-support-handoff.test.mjs",
    "test:frontend-topology-refresh": "node --test scripts/verify-frontend-topology-refresh.test.mjs",
    "test:frontend-runtime-hardening": "node --test scripts/verify-frontend-runtime-hardening.test.mjs",
    "test:release-contract": "node scripts/release-contract-audit.mjs",
    "verify:msdk-evidence": "node scripts/verify-msdk-evidence.mjs",
    "redact:msdk-evidence": "node scripts/redact-msdk-evidence.mjs",
    "redact:dji-mqtt-evidence": "node scripts/redact-dji-mqtt-evidence.mjs",
    "export:m3m-capture-evidence": "npm run build --workspace @fh-clone/adapter-dji-cloud && node scripts/export-m3m-capture-evidence.mjs",
    "verify:msdk-pairing-preflight": "node scripts/msdk-pairing-preflight.mjs",
    "test:pilot2-jsbridge": "node --test scripts/verify-pilot2-jsbridge.test.mjs",
    "test:pilot2-bootstrap": "node --test scripts/verify-pilot2-bootstrap.test.mjs",
    "verify:pilot2-jsbridge": "node scripts/verify-pilot2-jsbridge.mjs",
    "test:pilot2-evidence": "node --test scripts/export-pilot2-jsbridge-evidence.test.mjs",
    "export:pilot2-evidence": "node scripts/export-pilot2-jsbridge-evidence.mjs",
    "test:backup-restore": "sh scripts/test-timescale-backup-restore.sh",
    "test:control-api-openapi": "node scripts/verify-control-api-openapi.mjs",
    "test:wpml-evidence": "npm run build --workspace @fh-clone/adapter-dji-cloud && node --test scripts/export-wpml-pilot-evidence.test.mjs",
    "export:wpml-evidence": "npm run build --workspace @fh-clone/adapter-dji-cloud && node scripts/export-wpml-pilot-evidence.mjs",
    "verify:dji-thermal-sdk": "npm run build --workspace @fh-clone/adapter-dji-thermal && node scripts/dji-thermal-sdk.mjs --action status",
    "thermal:rjpeg": "npm run build --workspace @fh-clone/adapter-dji-thermal && node scripts/dji-thermal-sdk.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": "11.19.1"
  }
}
