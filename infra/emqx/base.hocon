authentication = [
  {
    mechanism = password_based
    backend = http
    enable = true

    method = post
    url = "http://control-api:8081/internal/emqx/authn"

    headers {
      "Content-Type" = "application/json"

      # Secure disabled default. The deployment renderer must replace this
      # placeholder with EMQX_AUTHN_TOKEN before MQTT authentication works.
      "Authorization" = "Bearer __FH_CLONE_AUTHN_DISABLED__"
    }

    body {
      username = "${username}"
      password = "${password}"
      clientid = "${clientid}"
      peerhost = "${peerhost}"
    }

    pool_size = 8
    connect_timeout = "1s"
    request_timeout = "1s"
  }
]

authorization {
  no_match = deny
  deny_action = ignore

  cache {
    enable = true
    max_size = 1024

    # Short by design: dynamic control revocations should not linger for 10s.
    ttl = 1s

    # Low-rate, command-like writes are always evaluated in real time.
    excludes = [
      "thing/product/+/services",
      "thing/product/+/property/set",
      "thing/product/+/drc/down",
      "thing/product/+/drc/up"
    ]
  }

  sources = [
    {
      type = http
      enable = true

      # EMQX 5.7 has no authorizer preconditions. The backend therefore
      # returns "ignore" for identities handled by the following file ACL.
      method = post
      url = "http://control-api:8081/internal/emqx/authz"

      headers {
        "Content-Type" = "application/json"

        # Secure disabled default. Deployment must replace this with the same
        # secret configured as EMQX_AUTHZ_TOKEN in control-api before dynamic
        # DJI/DRC authorization can succeed.
        "Authorization" = "Bearer __FH_CLONE_AUTHZ_DISABLED__"
      }

      body {
        username = "${username}"
        clientid = "${clientid}"
        peerhost = "${peerhost}"
        role = "${client_attrs.role}"
        gateway_sn = "${client_attrs.gateway_sn}"
        action = "${action}"
        topic = "${topic}"
        qos = "${qos}"
      }

      pool_size = 8
      request_timeout = "1s"
    },
    {
      type = file
      enable = true
      path = "/opt/emqx/etc/fh-clone-acl.conf"
    }
  ]
}
