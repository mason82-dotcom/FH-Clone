authorization {
  no_match = deny
  deny_action = ignore

  cache {
    enable = true
    max_size = 1024
    ttl = 5s
  }

  sources = [
    {
      type = http
      enable = true

      # Only provisioned DJI gateway identities need dynamic topology checks.
      precondition = "regex_match(username, '^dji-gateway-.+$')"

      method = post
      url = "http://control-api:8081/internal/emqx/authz"

      headers {
        "Content-Type" = "application/json"

        # Sicherer Default: funktioniert absichtlich nicht.
        # Produktion überschreibt diesen Wert per Environment:
        # EMQX_AUTHORIZATION__SOURCES__1__HEADERS__AUTHORIZATION='"Bearer <token>"'
        "Authorization" = "Bearer __FH_CLONE_AUTHZ_DISABLED__"
      }

      body {
        username = "${username}"
        clientid = "${clientid}"
        action = "${action}"
        topic = "${topic}"
        qos = "${qos}"
        peerhost = "${peerhost}"
      }
    },
    {
      type = file
      enable = true
      path = "/opt/emqx/etc/fh-clone-acl.conf"
    }
  ]
}
