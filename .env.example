# FH2 V3 – lokale Runtime
# Vor dem Start nach .env kopieren und alle change-me Werte ersetzen.

FH2_API_BIND=0.0.0.0
FH2_API_PORT=8080
FH2_WEB_BIND=0.0.0.0
FH2_WEB_PORT=8088

MQTT_BIND=0.0.0.0
MQTT_PORT=1883
EMQX_IMAGE=emqx/emqx:5.7.2

TIMESCALE_PASSWORD=change-me-timescale-password
MQTT_BACKEND_PASSWORD=change-me-backend-password
EMQX_AUTHN_TOKEN=change-me-authn-token
EMQX_AUTHZ_TOKEN=change-me-authz-token

DJI_CLOUD_API_VERSION=

# FlightHub 2 OpenAPI V2 – optionaler read-only Pfad
FH2_ENABLED=false
FH2_BASE_URL=
FH2_ORG_ID=
FH2_PROJECT_ID=
FH2_USER_TOKEN=
FH2_TIMEOUT_MS=15000
RTK_SOURCE_LABEL=
RTK_SOURCE_PROVIDER=
LOG_RAW_DJI=0


# FlightHub 2 Frontend Standalone Components (browserseitig, optional)
# Diese Werte werden beim Web-Image-Build in das Vite-Bundle übernommen.
VITE_FH2_STANDALONE_ENABLED=false
VITE_FH2_NATIVE_COCKPIT_ENABLED=false
VITE_FH2_HOST_URL=
VITE_FH2_SERVER_URL=
VITE_FH2_WSS_URL=
VITE_FH2_PROJECT_ID=
VITE_FH2_PROJECT_TOKEN=
VITE_FH2_PAAS_URL=
VITE_FH2_COCKPIT_PROP_STYLE=camel
VITE_FH2_GATEWAY_SN=
VITE_FH2_DRONE_SN=
VITE_FH2_WAYLINE_ID=
VITE_FH2_FLIGHT_PATH_ID=
